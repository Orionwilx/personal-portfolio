---
import SpringBootIcon from "../icons/SpringBoot.astro";
import DockerIcon from "../icons/Docker.astro";
import MongoIcon from "../icons/Mongo.astro";
import JavaIcon from "../icons/Java.astro";
import GithubIcon from "../icons/Github.astro";
import javaScriptIcon from "../icons/JavaScript.astro";
import ReactIcon from "../icons/React.astro";
import NodeIcon from "../icons/Nodejs.astro";
import GitIcon from "../icons/Git.astro";
import TailwindIcon from "../icons/Tailwind.astro";
import LaravelIcon from "../icons/Laravel.astro";
import PhpIcon from "../icons/Php.astro";
import PostgreSQLIcon from "../icons/PostgreSQL.astro";
import TypeScriptIcon from "../icons/TypeScript.astro";
import AwsIcon from "../icons/Aws.astro";

const TAGS = {
  LARAVEL: {
    name: "Laravel",
    class: "bg-[#4a1410] text-white",
    icon: LaravelIcon,
  },
  PHP: {
    name: "PHP",
    class: "bg-[#2e3359] text-white",
    icon: PhpIcon,
  },
  AWS: {
    name: "AWS",
    class: "bg-[#3d2a00] text-white",
    icon: AwsIcon,
  },
  TYPESCRIPT: {
    name: "TypeScript",
    class: "bg-[#0b2f4f] text-white",
    icon: TypeScriptIcon,
  },
  POSTGRESQL: {
    name: "PostgreSQL",
    class: "bg-[#1d3557] text-white",
    icon: PostgreSQLIcon,
  },
  REACT: {
    name: "React",
    class: "bg-[#002d47] text-white",
    icon: ReactIcon,
  },
  NODE: {
    name: "Node.js",
    class: "bg-[#275f18] text-white",
    icon: NodeIcon,
  },
  SPRING_BOOT: {
    name: "Spring Boot",
    class: "bg-[#1b4900c0] text-white",
    icon: SpringBootIcon,
  },
  JAVA: {
    name: "Java",
    class: "bg-[#FEFEFE] text-black",
    icon: JavaIcon,
  },
  DOCKER: {
    name: "Docker",
    class: "bg-[#002d47] text-white",
    icon: DockerIcon,
  },
  MONGODB: {
    name: "MongoDB",
    class: "bg-[#275f18] text-white",
    icon: MongoIcon,
  },
  GITHUB: {
    name: "GitHub",
    class: "bg-[#091e3f] text-white",
    icon: GithubIcon,
  },
  GIT: {
    name: "Git",
    class: "bg-[#5e2217] text-white",
    icon: GitIcon,
  },
  JAVASCRIPT: {
    name: "JavaScript",
    class: " bg-[#aba05b] text-white",
    icon: javaScriptIcon,
  },
  TAILWIND: {
    name: "Tailwind CSS",
    class: "bg-[#002d47] text-white",
    icon: TailwindIcon,
  },
};

const projects = [
  {
    title: "Plataforma SaaS de gestión de mantenimiento",
    badge: "Proyecto propio · En producción",
    description:
      "Plataforma web para empresas de mantenimiento industrial: clientes, hojas de vida de equipos, órdenes de trabajo, técnicos y reportes en PDF y Excel, con panel administrativo, portal para clientes y control de acceso por roles. Arquitectura de una instancia aislada por cliente desplegada en AWS. Ya opera con su primer cliente. Código privado.",
    tags: [TAGS.LARAVEL, TAGS.PHP, TAGS.TAILWIND, TAGS.AWS, TAGS.GIT],
  },
  {
    title: "Calculadora de métodos numéricos",
    description:
      "Aplicación web para resolver problemas de métodos numéricos con gráficas interactivas. Desarrollada con React, TypeScript y Vite, con manejo de estado en Zustand, cálculo con math.js y visualización con Recharts.",
    image:
      "https://image.thum.io/get/width/1200/crop/750/https://calculadora-nmerica.vercel.app",
    link: "https://calculadora-nmerica.vercel.app",
    github: "https://github.com/Orionwilx/calculadora-nmerica",
    tags: [TAGS.REACT, TAGS.TYPESCRIPT, TAGS.TAILWIND, TAGS.GITHUB],
  },
  {
    title: "Laravel + React (Inertia)",
    description:
      "Aplicación full-stack construida como prueba técnica: backend en Laravel con Inertia.js y frontend en React con TypeScript, componentes accesibles con Radix UI y estilos en Tailwind CSS.",
    github: "https://github.com/Orionwilx/laravel-technical-test",
    tags: [TAGS.LARAVEL, TAGS.REACT, TAGS.TYPESCRIPT, TAGS.TAILWIND],
  },
  {
    title: "MicroCommerce Spring Boot",
    description:
      "Sistema de e-commerce robusto y escalable, desarrollado con Spring Boot bajo una arquitectura de microservicios. Esto garantiza alta disponibilidad, resiliencia y facilita el desarrollo y despliegue independiente de cada módulo funcional.",
    image: "/curso-microservicios-ibm-coursera.webp",
    github: "https://github.com/Orionwilx/MicroCommerce-SpringBoot",
    tags: [
      TAGS.SPRING_BOOT,
      TAGS.JAVA,
      TAGS.POSTGRESQL,
      TAGS.MONGODB,
      TAGS.DOCKER,
    ],
  },
  {
    title: "Cine Search",
    description:
      "Aplicación web interactiva para buscar películas y consultar sus detalles. Se conecta a la API de OMDb para obtener información actualizada, mostrando el consumo de APIs externas en una interfaz amigable creada con React.",
    image:
      "https://github.com/user-attachments/assets/05f08444-46dc-422b-abc3-a8e6ac9727aa",
    link: "https://movie-searchorion.netlify.app/",
    github: "https://github.com/Orionwilx/search-movie-react",
    tags: [TAGS.REACT, TAGS.JAVASCRIPT, TAGS.TAILWIND, TAGS.GITHUB],
  },
  {
    title: "Tic Tac Toe React",
    description:
      "Clásico juego de Tic Tac Toe (Tres en Raya) implementado con React. Una aplicación interactiva que permite a dos jugadores competir en tiempo real, demostrando el manejo de estado y eventos en React.",
    image:
      "https://github.com/Orionwilx/React-learnProjects/raw/master/triqui-react/Screenshot%202025-04-06%20134408.png",
    link: "https://triki-react-orion.netlify.app/",
    github:
      "https://github.com/Orionwilx/React-learnProjects/tree/master/triqui-react",
    tags: [TAGS.REACT, TAGS.JAVASCRIPT, TAGS.GITHUB],
  },
];

const buttonClass =
  "inline-flex items-center px-4 py-2 mb-3 text-sm font-medium text-gray-900 bg-white border border-gray-200 rounded-lg hover:bg-gray-100 hover:text-blue-700 focus:z-10 focus:ring-4 focus:outline-none focus:ring-gray-100 focus:text-blue-700 dark:bg-gray-800 dark:text-gray-400 dark:border-gray-600 dark:hover:text-white dark:hover:bg-gray-700 dark:focus:ring-gray-700";
---

{
  projects.map(({ title, badge, description, image, link, github, tags }) => (
    <article class="shadow-md rounded-lg p-6 mb-6">
      {image && (
        <img
          src={image}
          alt={`Captura de pantalla del proyecto ${title}`}
          loading="lazy"
          class="w-full max-w-2xl h-60 object-cover object-top rounded-lg mb-4 shadow-2xl shadow-white/10"
        />
      )}
      <h3 class="text-2xl font-semibold text-yellow-200 mb-2">{title}</h3>
      {badge && (
        <p class="text-xs font-mono uppercase tracking-wide text-yellow-100/70 mb-2">
          {badge}
        </p>
      )}
      <p class="text-gray-400 mb-4">{description}</p>
      <div class="flex flex-wrap gap-4">
        {link && (
          <a href={link} target="_blank" rel="noopener" class={buttonClass}>
            Ver demo
            <svg class="w-3 h-3 ms-2 rtl:rotate-180" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 10">
              <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M1 5h12m0 0L9 1m4 4L9 9" />
            </svg>
          </a>
        )}
        {github && (
          <a href={github} target="_blank" rel="noopener" class={buttonClass}>
            Ver código
            <svg class="w-3 h-3 ms-2 rtl:rotate-180" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 10">
              <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M1 5h12m0 0L9 1m4 4L9 9" />
            </svg>
          </a>
        )}
      </div>
      <ul class="flex flex-wrap gap-2 flex-row mb-4">
        {tags.map((tag) => (
          <li>
            <span class={`flex gap-x-2 rounded-full text-xs ${tag.class} py-3.5 px-4`}>
              <tag.icon class="size-4" />
              {tag.name}
            </span>
          </li>
        ))}
      </ul>
    </article>
  ))
}
